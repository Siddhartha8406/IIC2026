# ============================================================================
# PROJECT PROMETHEUS — Backend Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and configure the secrets for your environment:
#   cp .env.example .env
# ============================================================================

# Server Port and Host
# Default to localhost (127.0.0.1) for local kiosk / personal deployment
PORT=8787
HOST=127.0.0.1

# JWT Secret for signing and verifying tokens
# Replace this with a strong random string in production
JWT_SECRET=prometheus_secret_jwt_key_change_me_in_production_12345

# AI Provider Configuration ('gemini' | 'anthropic')
AI_PROVIDER=gemini

# Google Gemini API Configuration (Default Provider)
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Configuration (Alternative Provider)
# Set AI_PROVIDER=anthropic to use Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Shared secret for /api/ai/generate proxy route
# If you expose this server beyond localhost, set this secret and match it
# with AI_BACKEND_SECRET in Project-Prometheus-NCC-ANO-System.html
LOCAL_SHARED_SECRET=

# Optional: Explicit allowed origin for CORS (e.g. http://localhost:3000)
# Note: file:// and localhost ports are automatically permitted by default
ALLOWED_ORIGIN=
